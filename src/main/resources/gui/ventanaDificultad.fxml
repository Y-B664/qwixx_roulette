            <children>

                <Label prefHeight="96.0" styleClass="brand-title" text="Qwixx_roulette" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0" />

                <HBox alignment="CENTER" spacing="16.0" AnchorPane.rightAnchor="8.0" AnchorPane.topAnchor="32.0">

                    <children>
                        <Region prefHeight="40.0" prefWidth="40.0" styleClass="color-chip, chip-red" />

                        <Region prefHeight="40.0" prefWidth="40.0" styleClass="color-chip, chip-yellow" />

                        <Region prefHeight="40.0" prefWidth="40.0" styleClass="color-chip, chip-green" />

                        <Region prefHeight="40.0" prefWidth="40.0" styleClass="color-chip, chip-blue" />
                    </children>
                </HBox>

                <Region prefHeight="2.0" styleClass="header-divider" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />

            </children>
        </AnchorPane>

        <!-- TÍTULO DE LA PANTALLA -->
        <Label alignment="CENTER" prefHeight="80.0" styleClass="screen-title" text="Dificultad del bot" AnchorPane.leftAnchor="96.0" AnchorPane.rightAnchor="96.0" AnchorPane.topAnchor="218.0" />

        <!-- TARJETAS DE DIFICULTAD -->
        <GridPane fx:id="dificultadesGrid" hgap="34.0" AnchorPane.bottomAnchor="234.0" AnchorPane.leftAnchor="96.0" AnchorPane.rightAnchor="96.0" AnchorPane.topAnchor="326.0">

            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.333333" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.333333" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.333334" />
            </columnConstraints>

            <children>

                <!-- FÁCIL -->
                <AnchorPane fx:id="facilCard" minWidth="0.0" GridPane.columnIndex="0">

                    <children>

                        <!-- El degradado está DETRÁS -->
                        <Region mouseTransparent="true" styleClass="card-halo, halo-green" AnchorPane.bottomAnchor="-12.0" AnchorPane.leftAnchor="-12.0" AnchorPane.rightAnchor="-12.0" AnchorPane.topAnchor="-12.0" />

                        <AnchorPane prefHeight="760.0" prefWidth="464.0" styleClass="difficulty-card" AnchorPane.bottomAnchor="-79.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

                            <children>

                                <Label alignment="CENTER" prefHeight="64.0" styleClass="card-title" text="Fácil" AnchorPane.leftAnchor="36.0" AnchorPane.rightAnchor="36.0" AnchorPane.topAnchor="20.0" />

                                <StackPane fx:id="imagenFacilPane" prefHeight="132.0" styleClass="image-slot, slot-green" AnchorPane.leftAnchor="36.0" AnchorPane.rightAnchor="36.0" AnchorPane.topAnchor="104.0">

                                    <children>

                                        <ImageView fx:id="imagenFacilView" cache="true" fitHeight="250.0" fitWidth="200.0" mouseTransparent="true" preserveRatio="true" StackPane.alignment="CENTER">
                                 <image>
                                    <Image url="@img/bots/Drako.png" />
                                 </image>
                                 <cursor>
                                    <Cursor fx:constant="DEFAULT" />
                                 </cursor></ImageView>
                                    </children>
                                </StackPane>

                                <Label alignment="CENTER" layoutX="44.0" layoutY="364.0" prefHeight="177.0" prefWidth="380.0" styleClass="card-description" text="En la dificultad fácil el bot esta limitado impidiendo que pueda usar power-ups ,y poniéndole fallos de manera aleatoria así facilitándote la partida." textAlignment="CENTER" wrapText="true" AnchorPane.bottomAnchor="142.0" AnchorPane.leftAnchor="42.0" AnchorPane.rightAnchor="42.0" AnchorPane.topAnchor="362.0" />

                                <Button fx:id="seleccionarFacilButton" mnemonicParsing="false" prefHeight="64.0" styleClass="select-button" text="Seleccionar" AnchorPane.bottomAnchor="49.0" AnchorPane.leftAnchor="36.0" AnchorPane.rightAnchor="36.0" />

                            </children>
                        </AnchorPane>
                    </children>
                </AnchorPane>

                <!-- MEDIA -->
                <AnchorPane fx:id="mediaCard" minWidth="0.0" GridPane.columnIndex="1">

                    <children>

                        <Region mouseTransparent="true" prefHeight="772.0" prefWidth="488.0" styleClass="card-halo, halo-yellow" AnchorPane.bottomAnchor="-79.0" AnchorPane.leftAnchor="-12.0" AnchorPane.rightAnchor="-12.0" AnchorPane.topAnchor="-12.0" />

                        <AnchorPane prefHeight="760.0" prefWidth="464.0" styleClass="difficulty-card" AnchorPane.bottomAnchor="-79.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

                            <children>

                                <Label alignment="CENTER" prefHeight="64.0" styleClass="card-title" text="Medio" AnchorPane.leftAnchor="36.0" AnchorPane.rightAnchor="36.0" AnchorPane.topAnchor="20.0" />

                                <StackPane fx:id="imagenMediaPane" prefHeight="132.0" styleClass="image-slot, slot-yellow" AnchorPane.leftAnchor="36.0" AnchorPane.rightAnchor="36.0" AnchorPane.topAnchor="104.0">

                                    <children>

                                        <ImageView fx:id="imagenMediaView" cache="true" fitHeight="250.0" fitWidth="350.0" mouseTransparent="true" nodeOrientation="INHERIT" preserveRatio="true" smooth="true">
                                 <image>
                                    <Image url="@img/bots/Azrael.png" />
                                 </image></ImageView>
                                    </children>
                                </StackPane>

                                <Label alignment="CENTER" contentDisplay="CENTER" styleClass="card-description" text="En la dificultad media  el bot limitándo a que solo pueda usar un power-up." textAlignment="CENTER" wrapText="true" AnchorPane.bottomAnchor="140.0" AnchorPane.leftAnchor="36.0" AnchorPane.rightAnchor="36.0" AnchorPane.topAnchor="254.0" />

                                <Button fx:id="seleccionarMediaButton" mnemonicParsing="false" prefHeight="64.0" styleClass="select-button" text="Seleccionar" AnchorPane.bottomAnchor="49.0" AnchorPane.leftAnchor="36.0" AnchorPane.rightAnchor="36.0" />

                            </children>
                        </AnchorPane>
                    </children>
                </AnchorPane>

                <!-- DIFÍCIL -->
                <AnchorPane fx:id="dificilCard" minWidth="0.0" GridPane.columnIndex="2">

                    <children>

                        <Region mouseTransparent="true" styleClass="card-halo, halo-red" AnchorPane.bottomAnchor="-12.0" AnchorPane.leftAnchor="-12.0" AnchorPane.rightAnchor="-12.0" AnchorPane.topAnchor="-12.0">
                            <effect>
                                <GaussianBlur radius="22.0" />
                            </effect>
                        </Region>





                        <AnchorPane prefHeight="760.0" prefWidth="464.0" styleClass="difficulty-card" AnchorPane.bottomAnchor="-79.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

                            <children>

                                <Label alignment="CENTER" prefHeight="64.0" styleClass="card-title" text="Difícil" AnchorPane.leftAnchor="36.0" AnchorPane.rightAnchor="36.0" AnchorPane.topAnchor="20.0" />

                                <StackPane fx:id="imagenDificilPane" prefHeight="132.0" styleClass="image-slot, slot-red" AnchorPane.leftAnchor="36.0" AnchorPane.rightAnchor="36.0" AnchorPane.topAnchor="104.0">

                                    <children>

                                        
                                        <ImageView fx:id="imagenDificilView" fitHeight="250.0" fitWidth="350.0" mouseTransparent="true" preserveRatio="true" smooth="true">
                                            <image>
                                                <Image url="@img/bots/Valtharion.png" />
                                            </image>
                                        </ImageView>
                                    </children>
                                </StackPane>

                                <Label alignment="CENTER" layoutX="40.0" layoutY="366.0" prefHeight="254.0" prefWidth="388.0" styleClass="card-description" text="En la dificultad difícil el bot puede usar hasta 3 power-up y la mayoría de las funciones que pueda hacer el jugador" textAlignment="CENTER" wrapText="true" AnchorPane.bottomAnchor="142.0" AnchorPane.leftAnchor="38.0" AnchorPane.rightAnchor="38.0" AnchorPane.topAnchor="364.0" />

                                <Button fx:id="seleccionarDificilButton" mnemonicParsing="false" prefHeight="64.0" styleClass="select-button" text="Seleccionar" AnchorPane.bottomAnchor="49.0" AnchorPane.leftAnchor="36.0" AnchorPane.rightAnchor="36.0" />

                            </children>
                        </AnchorPane>
                    </children>
                </AnchorPane>

            </children>
         <rowConstraints>
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <!-- ACCIÓN PRINCIPAL CENTRADA -->
        <HBox alignment="CENTER" prefHeight="76.0" AnchorPane.bottomAnchor="115.0" AnchorPane.leftAnchor="96.0" AnchorPane.rightAnchor="96.0" />
          <Button fx:id="jugarButton" layoutX="625.0" layoutY="1098.0" mnemonicParsing="false" prefHeight="76.0" prefWidth="432.0" styleClass="play-button" text="Jugar" />

    </children>
</AnchorPane>
