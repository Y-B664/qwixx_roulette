<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.scene.Group?>
        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.TextField?>
        <?import javafx.scene.effect.DropShadow?>
        <?import javafx.scene.layout.Pane?>
        <?import javafx.scene.layout.Region?>
        <?import javafx.scene.shape.Arc?>
        <?import javafx.scene.shape.Circle?>
        <?import javafx.scene.shape.Rectangle?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:id="principal"
            prefWidth="1652.0"
            prefHeight="1030.0"
            minWidth="900.0"
            minHeight="600.0"
            styleClass="principal-screen"
            stylesheets="@ventanaPrincipal.css"
            fx:controller="controllers.VentanaPrincipalController"
            style="-fx-background-color: white;
                   -fx-font-family: 'Pixelify Sans';">

<children>
    <!-- Cabecera -->
    <Label text="Qwixx_roulette"
           layoutX="96.0"
           layoutY="68.0"
           prefWidth="1150.0"
           prefHeight="96.0"
           style="-fx-font-size: 76px;
                      -fx-text-fill: #191919;"/>

    <Rectangle x="96.0" y="186.0"
               width="1460.0" height="2.0"
               fill="#D6D9DB"/>

    <!-- Colores del tablero -->
    <Rectangle x="1340.0" y="100.0"
               width="40.0" height="40.0"
               arcWidth="16.0" arcHeight="16.0"
               fill="#E53935"/>

    <Rectangle x="1396.0" y="100.0"
               width="40.0" height="40.0"
               arcWidth="16.0" arcHeight="16.0"
               fill="#FBC02D"/>

    <Rectangle x="1452.0" y="100.0"
               width="40.0" height="40.0"
               arcWidth="16.0" arcHeight="16.0"
               fill="#2E7D32"/>

    <Rectangle x="1508.0" y="100.0"
               width="40.0" height="40.0"
               arcWidth="16.0" arcHeight="16.0"
               fill="#1E88E5"/>

    <Pane layoutX="96.0"
          layoutY="254.0"
          prefWidth="640.0"
          prefHeight="640.0">

        <children>

            <!-- Imagen de la ruleta -->
            <ImageView fitWidth="640.0"
                       fitHeight="640.0"
                       preserveRatio="true"
                       layoutX="0.0"
                       layoutY="0.0"
                       mouseTransparent="true">
                <image>
                    <Image url="@/gui/img/boton_ruleta.png"/>
                </image>
            </ImageView>

            <!-- Área circular pulsable -->
            <Button fx:id="jugarButton"
                    accessibleText="Jugar"
                    layoutX="83.593"
                    layoutY="83.593"
                    prefWidth="472.813"
                    prefHeight="472.813"
                    pickOnBounds="false"
                    style="-fx-background-color: transparent;
                       -fx-border-color: transparent;
                       -fx-padding: 0;
                       -fx-cursor: hand;">

                <shape>
                    <Circle radius="236.406"/>
                </shape>
            </Button>

            <!-- Rectángulo central -->
            <Region layoutX="166.0"
                    layoutY="268.0"
                    prefWidth="308.0"
                    prefHeight="104.0"
                    mouseTransparent="true"
                    style="-fx-background-color: #191919;
                       -fx-background-radius: 24;
                       -fx-border-color: #FFFFFFCC;
                       -fx-border-width: 2;
                       -fx-border-radius: 24;"/>

            <!-- Texto central -->
            <Label text="Jugar"
                   layoutX="166.0"
                   layoutY="268.0"
                   prefWidth="308.0"
                   prefHeight="104.0"
                   alignment="CENTER"
                   mouseTransparent="true"
                   style="-fx-font-size: 52px;
                      -fx-text-fill: white;"/>

        </children>
    </Pane>

    <!-- Panel de opciones -->
    <Pane layoutX="850.0"
          layoutY="330.0"
          prefWidth="706.0"
          prefHeight="500.0"
          style="-fx-background-color: white;
                     -fx-background-radius: 30;
                     -fx-border-color: #D6D9DB;
                     -fx-border-width: 2;
                     -fx-border-radius: 30;">

        <effect>
            <DropShadow radius="20.0"
                        offsetY="6.0"
                        color="#0000000F"/>
        </effect>

        <children>

            <TextField fx:id="nombreUsuarioField"
                       promptText="Nombre de Usuario"
                       layoutX="48.0"
                       layoutY="44.0"
                       prefWidth="610.0"
                       prefHeight="104.0"
                       style="-fx-font-size: 38px;
                                  -fx-text-fill: #191919;
                                  -fx-prompt-text-fill: #191919;
                                  -fx-background-color: #F9F9F9;
                                  -fx-background-radius: 20;
                                  -fx-border-color: #D6D9DB;
                                  -fx-border-width: 2;
                                  -fx-border-radius: 20;
                                  -fx-padding: 0 32 0 32;"/>

            <Button fx:id="instruccionesButton"
                    text="Ver instrucciones"
                    mnemonicParsing="false"
                    layoutX="48.0"
                    layoutY="192.0"
                    prefWidth="610.0"
                    prefHeight="104.0"
                    style="-fx-font-size: 40px;
                               -fx-text-fill: #191919;
                               -fx-background-color: white;
                               -fx-background-radius: 20;
                               -fx-border-color: #191919;
                               -fx-border-width: 2;
                               -fx-border-radius: 20;
                               -fx-cursor: hand;"/>

            <Button fx:id="rankingButton"
                    text="Ranking"
                    mnemonicParsing="false"
                    layoutX="48.0"
                    layoutY="340.0"
                    prefWidth="610.0"
                    prefHeight="104.0"
                    style="-fx-font-size: 40px;
                               -fx-text-fill: white;
                               -fx-background-color: #191919;
                               -fx-background-radius: 20;
                               -fx-border-radius: 20;
                               -fx-cursor: hand;"/>

        </children>
    </Pane>

</children>
</AnchorPane>